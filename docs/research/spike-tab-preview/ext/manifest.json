{
 "manifest_version": 3,
 "name": "tabspike",
 "version": "1",
 "minimum_chrome_version": "116",
 "permissions": [
  "tabs",
  "activeTab",
  "tabCapture",
  "debugger",
  "scripting",
  "pageCapture",
  "offscreen",
  "storage"
 ],
 "host_permissions": [
  "<all_urls>"
 ],
 "background": {
  "service_worker": "sw.js"
 },
 "action": {
  "default_title": "tabspike: grant activeTab to this tab"
 }
}